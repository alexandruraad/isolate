{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "isolate",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "window": {
        "all": false,
        "close": true,
        "minimize": true,
        "maximize": true,
        "setTitle": true,
        "show": true,
        "hide": true
      },
      "notification": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "io.isolate.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png"
      ]
    },
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:7778 ws://127.0.0.1:7779"
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "label": "main",
        "title": "isolate",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}
